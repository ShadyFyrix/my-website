{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shadyfyrix",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-26",
  "vars": {
    "STEAM_ID64": "76561198904940621"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
